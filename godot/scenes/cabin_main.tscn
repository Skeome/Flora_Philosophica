; ── cabin_main.tscn patch ────────────────────────────────────────────────────
; Append these nodes to the END of cabin_main.tscn, before the final blank line.
;
; Why a CanvasLayer instead of a Node2D child?
;   The cabin camera is clamped to 0–480 × 0–320 world pixels.
;   A CanvasLayer at layer = -5 renders in screen space and is always
;   behind everything, giving a fixed warm-wood floor that fills the viewport
;   regardless of camera position.  When actual wood-floor tiles are painted
;   onto the Ground TileMapLayer in the editor, this ColorRect can be removed.

[node name="FloorLayer" type="CanvasLayer" parent="."]
layer = -5

[node name="FloorBG" type="ColorRect" parent="FloorLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.627, 0.431, 0.255, 1)

; Color(0.627, 0.431, 0.255) == rgb(160, 110, 65) — the "lighter plank"
; value from the original Raylib map.cpp WoodFloor rendering code.
; The darker plank alternation (140, 95, 55) can be added once real
; TileMapLayer data is in place.

[node name="InventoryUI" parent="." instance=ExtResource("7_inv")]
